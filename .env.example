# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole
# estate's secrets — is banned, and this file is what makes the alternative possible: the deploy
# manifest is derived from it.
#
# PLACEHOLDERS ONLY. Copy to `.env` (or `.env.local`) for local work; both are gitignored and
# must stay that way. Nothing real belongs in this file, and the Foundry key in particular must
# never be pasted back here — it is a spend credential.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
STUDIO_DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio

# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for outbound event signatures. At least 32 random characters:
#   openssl rand -base64 32
# Leaving a placeholder here is refused at boot, deliberately. Do not paste one back in.
OUTBOX_SIGNING_SECRET=

# --- the image backend: FLUX on Azure AI Foundry, all optional -----------------------------------
#
# ALL OF THIS IS OPTIONAL, AND THAT IS THE DESIGN. With none of it set the service boots, serves
# every route, reports its image backend as a SOFT readiness dependency, and generates through the
# deterministic placeholder backend. Unconfigured is `degraded`, never `fail`: a brand kit can
# still be created, listed and read while no model is reachable.
#
# The model is FLUX 2 Pro from Black Forest Labs, served by Azure AI Foundry. NOT Azure OpenAI —
# the route, the request body and the error vocabulary are all different.

# The Foundry resource. No trailing slash, no path.
AZURE_FOUNDRY_ENDPOINT=https://REPLACE-ME.services.ai.azure.com
# The resource key. A SPEND credential: it is never logged, never echoed by a route, and never
# committed. Read it from the environment.
AZURE_FOUNDRY_API_KEY=
# The provider route under the endpoint. Note the HYPHENS here — this is the URL path, and it is
# spelled differently from the model name below.
AZURE_FOUNDRY_IMAGE_PATH=/providers/blackforestlabs/v1/flux-2-pro

# ┌──────────────────────────────────────────────────────────────────────────────────────────────┐
# │ THE MODEL NAME USES DOTS. `FLUX.2-pro`, not `flux-2-pro`.                                     │
# │                                                                                               │
# │ It is sent in the request BODY and it is REQUIRED — omitting it is 400 `no_model_name`, even   │
# │ though AZURE_FOUNDRY_IMAGE_PATH above already names the model. Sending the hyphenated path     │
# │ spelling as the model is 404 `DeploymentNotFound`, which reads exactly like a model that was   │
# │ never deployed. Both verified against the live resource.                                      │
# └──────────────────────────────────────────────────────────────────────────────────────────────┘
STUDIO_IMAGE_MODEL=FLUX.2-pro

# Tried on 404 (not deployed), 429 (capacity) and 5xx. Never on 400: a bad prompt fails identically
# on both models and retrying only spends the fallback's quota too.
#
# EMPTY BY DEFAULT, because only FLUX.2-pro is deployed on this resource — FLUX.1.5-pro, FLUX.1-pro,
# FLUX-1.1-pro, FLUX.1.1-pro, FLUX.1-Kontext-pro, FLUX.2-flex and FLUX.2-dev were all probed and
# all seven answer 404. Set it when a second model is deployed; no code change is needed.
STUDIO_IMAGE_FALLBACK_MODEL=

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4015
NODE_ENV=development
LOG_LEVEL=info
STUDIO_DATABASE_POOL_MAX=10

# Wall-clock ceiling on one image call. Generation runs in a leased job, not in the request, so
# this can be generous — but not unbounded: a hung call holds a lease and a job slot. A measured
# FLUX.2-pro call at 256 square takes about 4 seconds and at 1024 square about 20 to 40.
# STUDIO_IMAGE_DEADLINE_MS=120000

# Estimated price of one image, in whole US dollars, used for the credit reservation.
# Configuration rather than a table in code: the provider reports `request_meta.cost` in its own
# units (a flat 3 per image at every size probed) and publishes no exchange rate on this surface,
# so a dollar figure hardcoded here would be a guess nobody could correct. The provider's own
# number is recorded verbatim on every job alongside this estimate.
# STUDIO_IMAGE_PRICE_USD=0.06

# Where generated bytes land, and the base the recorded `storage_url` is built from. A directory
# rather than an object store because the estate has no object-store service yet; `AssetBlobStore`
# in src/assets.ts is the seam that swaps it for one.
#
# ┌──────────────────────────────────────────────────────────────────────────────────────────────┐
# │ SET THIS IN EVERY CONTAINER DEPLOY. The default is `./out`, which is right for a laptop and   │
# │ wrong for the image: it resolves to `/app/out`, the image's last instruction is `USER node`   │
# │ (uid 1000), and a directory created inside `/app` is owned by root. It was left unset once,   │
# │ and every generation of every kind failed EACCES while the container reported healthy.        │
# │                                                                                               │
# │ Point it at a mounted volume the deploy has made writable, and `chown` the mount point: a     │
# │ fresh named volume's mount point is created `root:root`, and on Docker Desktop virtiofs maps  │
# │ ownership so a wrong deploy can appear to work on a Mac and fail on Linux.                    │
# │                                                                                               │
# │ The service now refuses to start on an unwritable root, and `/readyz` answers 503 if it       │
# │ becomes unwritable later — both by writing a file and removing it, never by `fs.access`.      │
# └──────────────────────────────────────────────────────────────────────────────────────────────┘
# STUDIO_ASSET_ROOT=./out
# STUDIO_ASSET_BASE_URL=

# The default per-account spend cap, in whole US dollars, applied when an account has no row of
# its own. Enforced BEFORE the HTTP call, which is the difference between this and asset-forge's
# $2 default with a TTY prompt.
# STUDIO_DEFAULT_CREDIT_CAP_USD=5

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded
# ahead of the process (NODE_OPTIONS=--import @opentelemetry/auto-instrumentations-node/register),
# not by src/env.ts. They belong in the deploy, not here, because this service never reads them.
#
# STUDIO_TEST_DATABASE_URL is read only by the test suite, and only when its name contains
# "test" — the database-backed tests truncate.
#
# STUDIO_LIVE_FLUX=1 opts three tests into probing the real endpoint, which costs money. They skip
# otherwise, so a laptop and CI are both green without a spend credential.
